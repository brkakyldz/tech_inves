# Back-end API base URL (src/techinves/api) — report/BACKEND_IMPLEMENTATION_PLAN.md
# Server-side only (no NEXT_PUBLIC_ prefix): every current data-fetching call
# site is a Server Component / generateStaticParams, not client-side fetch.
API_BASE_URL=http://localhost:8000

# Shared secret the ingestion job sends as the X-Revalidate-Secret header
# when it calls POST /api/revalidate?tag=scores after a successful ingest.
REVALIDATE_SECRET=change-me-in-production
