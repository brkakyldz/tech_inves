FMP_API_KEY=your_fmp_api_key_here

# LLM (LangChain) — OpenAI GPT-5.6 Luna, used for both the research agents
# (fan-out over Tavily) and the synthesis/verifier nodes. Single model chosen
# for cost reasons (CV/portfolio project) — see report/ARCHITECTURE_PROPOSAL.md §3.
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Back-end API (src/techinves/api) — report/BACKEND_IMPLEMENTATION_PLAN.md
# Defaults to a local sqlite file if unset; prod uses a Neon Postgres URL,
# e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Comma-separated extra CORS origins beyond http://localhost:3000 and the
# https://techinves-*.vercel.app preview pattern (which is always allowed).
CORS_ALLOWED_ORIGINS=
