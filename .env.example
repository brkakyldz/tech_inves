# TechInves - environment template. Copy to .env and fill in your own values.
# The app boots with none of these set (demo mode); the three keys in the
# first block are what turn the run triggers on.

# ---------------------------------------------------------------------------
# Required for real runs
# ---------------------------------------------------------------------------

# Fundamentals: share price, market cap, sector/industry.
# Required by every trigger (scores, report, company). Free tier is enough.
FMP_API_KEY=

# LLM for research extraction, synthesis, and the verifier's judge layer.
# Required by the report and company triggers.
OPENAI_API_KEY=

# Web search for the research fan-out (company + macro branches).
# Required by the report and company triggers.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# SEC requires a contact address in the User-Agent of every data.sec.gov
# request. Shape: "AppName/version (you@example.com)". Left unset, the code
# falls back to a placeholder that is not yours - set your own before running
# anything against EDGAR.
SEC_EDGAR_USER_AGENT=

# ---------------------------------------------------------------------------
# Optional providers - unset means the leg is skipped, never an error
# ---------------------------------------------------------------------------

# Exa: fallback search when Tavily rate-limits under a full-watchlist fan-out.
EXA_API_KEY=

# FRED: the macro spine table in the report's Sector & Macro section.
# Unset = the section is written without that table.
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# Database. Default is a local sqlite file (data/dev.db).
# Postgres: postgresql+asyncpg://user:pass@host:5432/techinves
DATABASE_URL=

# Extra CORS origins, comma-separated. http://localhost:3000 is always
# allowed, so this is only needed when the front end runs somewhere else.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Pipeline tuning - defaults shown, uncomment only to override
# ---------------------------------------------------------------------------

# Models. WRITER/JUDGE default to LLM_MODEL; setting them apart makes the
# verifier's judge a different model from the writer it grades.
# PIPELINE_LLM_MODEL=gpt-5.6-luna
# PIPELINE_WRITER_MODEL=
# PIPELINE_JUDGE_MODEL=

# Research fan-out
# PIPELINE_RESEARCH_CONCURRENCY=6
# PIPELINE_RESEARCH_MAX_RETRIES=2
# PIPELINE_RESEARCH_RETRY_BACKOFF_SECONDS=1.0
# PIPELINE_RESEARCH_LOOKBACK_DAYS=7
# PIPELINE_HIGHLIGHT_PROBE_MAX_RESULTS=20
# PIPELINE_EXA_FALLBACK_MIN_RESULTS=2

# How many past runs count as "already covered" for de-duplication.
# Too low and repeated runs resurface the same events; too high and a
# developing story gets suppressed.
# PIPELINE_COVERED_EVENTS_TRAILING_RUNS=4

# Warn when a run's findings fall below this fraction of the trailing median.
# PIPELINE_YIELD_FLOOR_FRACTION=0.5
# PIPELINE_YIELD_FLOOR_TRAILING_RUNS=8

# Blended $/1K-token rate used for the cost estimate shown in the UI.
# Approximate by design - it feeds a trend, not an invoice.
# PIPELINE_COST_PER_1K_INPUT_TOKENS=0.005
# PIPELINE_COST_PER_1K_OUTPUT_TOKENS=0.015